# Template only — DO NOT fill this in here and DO NOT commit a real .env.
#
# Copy it to your Home Assistant box instead, where it never touches the
# internet. Via the Samba or File Editor add-on:
#
#     /addon_configs/<hash>_claude_code/.env
#
# The add-on sources that file into the environment on every start. It lives on
# the HA data partition: outside the published image, outside git.
#
# You do NOT need a Home Assistant token here. Supervisor injects a scoped,
# self-rotating one, already exported as HA_URL and HA_TOKEN.

# GH_TOKEN=
# OPENAI_API_KEY=
# TAILSCALE_AUTHKEY=
